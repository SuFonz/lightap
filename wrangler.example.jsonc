/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lightap",
	"compatibility_date": "2026-09-23",
	"main": "worker.ts",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES",
		"remote": false
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	// KV
	// "kv_namespaces": [
	// 	{
	// 		"binding": "KV",
	// 		"id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
	// 		"remote": false
	// 	}
	// ],
	"durable_objects": {
		"bindings": [
			{
				"name": "SSE_DO",
				"class_name": "SSEDurableObject"
			}
		]
	},
	"exports": {
		"SSEDurableObject": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"queues": {
		"producers": [
		{
			"queue": "ap-delivery",
			"binding": "AP_QUEUE"
		}
		],
		"consumers": [
		{
			"queue": "ap-delivery",
			"max_batch_size": 10,
			"max_batch_timeout": 5
		}
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lightap-db",
			"database_id": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
			"migrations_dir": "drizzle",
			"migrations_pattern": "drizzle/*/migration.sql",
		}
	],
	"vars": {
		// Optional, public values only (safe to commit).
		// "TURNSTILE_SITE_KEY": "",
		// "LLM_BASE_URL": "",
		// "LLM_MODEL": "",
		// "CF_AIG_GATEWAY_ID": ""
	},

	// ── Secrets ────────────────────────────────────────────────
	// Create with: npx wrangler secret put <NAME>
	//
	// Required:
	//   JWT_SECRET          — session signing key
	//
	// Optional (feature stays off when unset):
	//   TURNSTILE_SECRET_KEY — bot protection on sign-up; needs TURNSTILE_SITE_KEY too
	//   LLM_API_KEY          — translation; needs LLM_BASE_URL too
	

	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	// "vars": {  "MY_VARIABLE": "production_value" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}